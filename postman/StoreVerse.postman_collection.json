{
  "info": {
    "name": "StoreVerse API",
    "description": "Comprehensive Postman collection covering all REST API endpoints in StoreVerse (Users & Auth, Stores, Products, Inventory, Customers & Segments, Orders & Shipments, Marketing Campaigns, and Team Members).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "userId", "value": "1" },
    { "key": "storeId", "value": "1" },
    { "key": "productId", "value": "1" },
    { "key": "customerId", "value": "1" },
    { "key": "orderId", "value": "1" },
    { "key": "shipmentId", "value": "1" },
    { "key": "trackingId", "value": "TRK-STORE-001" },
    { "key": "warehouseId", "value": "1" },
    { "key": "inventoryId", "value": "1" },
    { "key": "staffId", "value": "1" },
    { "key": "campaignId", "value": "1" },
    { "key": "teamMemberId", "value": "1" },
    { "key": "email", "value": "owner@storeverse.com" },
    { "key": "verifyToken", "value": "email-verification-token" },
    { "key": "otp", "value": "123456" },
    { "key": "inviteToken", "value": "team-invite-token" }
  ],
  "item": [
    {
      "name": "General",
      "item": [
        {
          "name": "API Health / Welcome",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "1. User & Authentication",
      "item": [
        {
          "name": "1. Register (Sends Email Verification)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/user/register"
          }
        },
        {
          "name": "2. Verify Email",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/user/verify-email?token={{verifyToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "verify-email"],
              "query": [{ "key": "token", "value": "{{verifyToken}}" }]
            }
          }
        },
        {
          "name": "3. Complete Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"name\": \"Alex Mercer\",\n  \"password\": \"SecurePass123!\",\n  \"phoneNumber\": \"+15551234567\"\n}"
            },
            "url": "{{baseUrl}}/api/user/complete-registration"
          }
        },
        {
          "name": "4. Login (Generates & Sends OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": "{{baseUrl}}/api/user/login"
          }
        },
        {
          "name": "5. Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/user/verify-otp"
          }
        },
        {
          "name": "6. Fetch User by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user/fetchUser/{{userId}}"
          }
        },
        {
          "name": "7. Get All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user/getAll"
          }
        },
        {
          "name": "8. Update User Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Mercer Updated\",\n  \"phoneNumber\": \"+15559876543\"\n}"
            },
            "url": "{{baseUrl}}/api/user/update/{{userId}}"
          }
        },
        {
          "name": "9. Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewPassword456!\"\n}"
            },
            "url": "{{baseUrl}}/api/user/change-password/{{userId}}"
          }
        },
        {
          "name": "10. Forgot Password (Request Reset Link)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/user/forgot-password"
          }
        },
        {
          "name": "11. Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verifyToken}}\",\n  \"password\": \"BrandNewPassword789!\"\n}"
            },
            "url": "{{baseUrl}}/api/user/reset-password"
          }
        }
      ]
    },
    {
      "name": "2. Store Management",
      "item": [
        {
          "name": "Create Store",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{userId}},\n  \"storeName\": \"Apex Trend Store\",\n  \"category\": \"Fashion & Apparel\",\n  \"businessAddress\": \"123 Commerce Way\",\n  \"country\": \"United States\",\n  \"currency\": \"USD\",\n  \"subDomain\": \"apex-trends\",\n  \"image\": \"https://images.unsplash.com/photo-1472851294608-062f824d29cc\"\n}"
            },
            "url": "{{baseUrl}}/api/store/add-store"
          }
        },
        {
          "name": "Get Stores by User ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/store/user-stores/{{userId}}"
          }
        },
        {
          "name": "Get Store by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/store/getstore/{{storeId}}"
          }
        },
        {
          "name": "Update Store",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"Apex Trend Store (Updated)\",\n  \"category\": \"Fashion & Lifestyle\",\n  \"businessAddress\": \"456 Market Boulevard\",\n  \"country\": \"United States\",\n  \"currency\": \"USD\",\n  \"subDomain\": \"apex-trends-updated\",\n  \"isActive\": true,\n  \"sslEnabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/store/UpdateStore/{{storeId}}"
          }
        },
        {
          "name": "Add Staff Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"name\": \"Sarah Jenkins\",\n  \"email\": \"sarah.staff@storeverse.com\",\n  \"role\": \"Manager\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/api/store/add-role"
          }
        },
        {
          "name": "Get Store Staff",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/store/get-staff/{{storeId}}"
          }
        },
        {
          "name": "Update Staff Member",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Jenkins-Cole\",\n  \"role\": \"Admin\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/api/store/update-staff/{{staffId}}"
          }
        },
        {
          "name": "Delete Staff Member",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/store/delete-staff/{{staffId}}"
          }
        },
        {
          "name": "Add Region & Tax Rate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"country\": \"United States\",\n  \"code\": \"US\",\n  \"taxRate\": \"7.5\",\n  \"shippingZone\": \"North America\"\n}"
            },
            "url": "{{baseUrl}}/api/store/add-tax"
          }
        },
        {
          "name": "Get Store Regions & Taxes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/store/get-country/{{storeId}}"
          }
        },
        {
          "name": "Save Store Theme Customization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"primaryColor\": \"#4F46E5\",\n  \"fontFamily\": \"Inter\",\n  \"storeLogoUrl\": \"https://example.com/logo.png\"\n}"
            },
            "url": "{{baseUrl}}/api/store/customize"
          }
        },
        {
          "name": "Get Store Theme Customization",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/store/get-color/{{storeId}}"
          }
        }
      ]
    },
    {
      "name": "3. Products",
      "item": [
        {
          "name": "Add Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"name\": \"Wireless Active Noise Cancelling Headphones\",\n  \"description\": \"Premium over-ear headphones with 40-hour battery life and spatial audio.\",\n  \"category\": \"Electronics\",\n  \"price\": \"149.99\",\n  \"stock\": 50,\n  \"sku\": \"HEAD-ANC-001\",\n  \"barcode\": \"978020137962\",\n  \"status\": \"active\",\n  \"image\": \"https://images.unsplash.com/photo-1505740420928-5e560c06d30e\",\n  \"variants\": \"[{\\\"color\\\":\\\"Black\\\",\\\"price\\\":\\\"149.99\\\"},{\\\"color\\\":\\\"Silver\\\",\\\"price\\\":\\\"159.99\\\"}]\"\n}"
            },
            "url": "{{baseUrl}}/api/product/add-product"
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/product/get-product/{{productId}}"
          }
        },
        {
          "name": "Get All Products by Store",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/product/store-products/{{storeId}}"
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless ANC Headphones Pro (2nd Gen)\",\n  \"price\": \"139.99\",\n  \"stock\": 45,\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/api/product/update-product/{{productId}}"
          }
        },
        {
          "name": "Bulk Upload Products",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"products\": [\n    {\n      \"name\": \"Minimalist Leather Watch\",\n      \"description\": \"Genuine Italian leather strap with sapphire crystal glass.\",\n      \"category\": \"Accessories\",\n      \"price\": \"199.00\",\n      \"stock\": 25,\n      \"sku\": \"WATCH-LTHR-01\",\n      \"status\": \"active\"\n    },\n    {\n      \"name\": \"Organic Cotton Hoodie\",\n      \"description\": \"100% GOTS certified organic heavyweight cotton.\",\n      \"category\": \"Fashion\",\n      \"price\": \"79.50\",\n      \"stock\": 80,\n      \"sku\": \"HOOD-ORG-02\",\n      \"status\": \"active\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/product/bulk-upload"
          }
        }
      ]
    },
    {
      "name": "4. Inventory & Warehouses",
      "item": [
        {
          "name": "Create Warehouse",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"name\": \"Central Distribution Hub - Lagos\"\n}"
            },
            "url": "{{baseUrl}}/api/inventory/add-warehouse"
          }
        },
        {
          "name": "Get Warehouses by Store",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/inventory/warehouses/{{storeId}}"
          }
        },
        {
          "name": "Add Inventory Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"productId\": {{productId}},\n  \"warehouseId\": {{warehouseId}},\n  \"quantity\": 120\n}"
            },
            "url": "{{baseUrl}}/api/inventory/add-inventory"
          }
        },
        {
          "name": "Get Store Inventory Listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/inventory/store-inventory/{{storeId}}"
          }
        },
        {
          "name": "Get Inventory Summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/inventory/summary/{{storeId}}"
          }
        },
        {
          "name": "Adjust Stock Quantity",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 95\n}"
            },
            "url": "{{baseUrl}}/api/inventory/adjust-stock/{{inventoryId}}"
          }
        }
      ]
    },
    {
      "name": "5. Customers & Segments",
      "item": [
        {
          "name": "Add Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"firstName\": \"Sophia\",\n  \"lastName\": \"Chen\",\n  \"email\": \"sophia.chen@example.com\",\n  \"phone\": \"+15552345678\",\n  \"address\": \"742 Evergreen Terrace\",\n  \"city\": \"San Francisco\",\n  \"state\": \"CA\",\n  \"postal\": \"94102\",\n  \"country\": \"United States\",\n  \"tags\": \"vip,early-adopter\",\n  \"notes\": \"Referred by partner network.\",\n  \"preferedCurrency\": \"USD\",\n  \"preferedLanguage\": \"en\",\n  \"emailMarketing\": true,\n  \"smsMarketing\": false\n}"
            },
            "url": "{{baseUrl}}/api/customer/add-customer"
          }
        },
        {
          "name": "Get Customers by Store",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customer/get-customers/{{storeId}}"
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customer/get-customer/{{customerId}}"
          }
        },
        {
          "name": "Update Customer Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Sophia\",\n  \"lastName\": \"Chen-Vance\",\n  \"phone\": \"+15559998877\",\n  \"emailMarketing\": true,\n  \"smsMarketing\": true\n}"
            },
            "url": "{{baseUrl}}/api/customer/update-customer/{{customerId}}"
          }
        },
        {
          "name": "Add Note to Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Customer requested expedited dispatch for upcoming orders.\"\n}"
            },
            "url": "{{baseUrl}}/api/customer/add-note/{{customerId}}"
          }
        },
        {
          "name": "Get Customer Notes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customer/get-notes/{{customerId}}"
          }
        },
        {
          "name": "Add Tag to Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag\": \"wholesale\"\n}"
            },
            "url": "{{baseUrl}}/api/customer/add-tag/{{customerId}}"
          }
        },
        {
          "name": "Get Customer Tags",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customer/get-tags/{{customerId}}"
          }
        },
        {
          "name": "Delete Tag from Customer",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tag\": \"wholesale\"\n}"
            },
            "url": "{{baseUrl}}/api/customer/delete-tag/{{customerId}}"
          }
        },
        {
          "name": "Send Email Message to Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Exclusive 20% discount on your next order\",\n  \"message\": \"Hi Sophia, thank you for being a loyal customer! Use promo code LOYAL20 at checkout.\"\n}"
            },
            "url": "{{baseUrl}}/api/customer/send-message/{{customerId}}"
          }
        },
        {
          "name": "Create Customer Segment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"High-Value VIPs\",\n  \"description\": \"Customers tagged with VIP and subscribed to email marketing\",\n  \"conditions\": [\n    { \"field\": \"tags\", \"operator\": \"contains\", \"value\": \"vip\" },\n    { \"field\": \"emailMarketing\", \"operator\": \"eq\", \"value\": \"true\" }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/customer/create-segment/{{storeId}}"
          }
        },
        {
          "name": "Get Store Customer Segments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/customer/get-segments/{{storeId}}"
          }
        }
      ]
    },
    {
      "name": "6. Orders & Shipments",
      "item": [
        {
          "name": "Create Order (Guest / Linked Customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": {{storeId}},\n  \"customerName\": \"Sophia Chen\",\n  \"customerEmail\": \"sophia.chen@example.com\",\n  \"customerPhone\": \"+15552345678\",\n  \"paymentMethod\": \"card\",\n  \"transactionId\": \"TXN-2026-9988\",\n  \"paymentStatus\": \"paid\",\n  \"status\": \"paid\",\n  \"tax\": \"12.50\",\n  \"shippingFee\": \"8.00\",\n  \"shipping\": {\n    \"recipient\": \"Sophia Chen\",\n    \"street\": \"742 Evergreen Terrace\",\n    \"city\": \"San Francisco\",\n    \"state\": \"CA\",\n    \"postal\": \"94102\",\n    \"country\": \"United States\"\n  },\n  \"items\": [\n    {\n      \"productName\": \"Wireless Active Noise Cancelling Headphones\",\n      \"productId\": {{productId}},\n      \"unitPrice\": \"149.99\",\n      \"quantity\": \"1\",\n      \"variantAttributes\": { \"color\": \"Black\" }\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Get Orders by Store",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/{{storeId}}"
          }
        },
        {
          "name": "Get Order Summary / Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/summary/{{storeId}}"
          }
        },
        {
          "name": "Get Order by ID or Order Number",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/order/{{orderId}}"
          }
        },
        {
          "name": "Update Order Status & Dispatch Shipment",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"shipped\",\n  \"courier\": \"DHL Express\",\n  \"trackingId\": \"{{trackingId}}\",\n  \"estimatedDelivery\": \"2026-09-10T18:00:00.000Z\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/status/{{orderId}}"
          }
        },
        {
          "name": "Process Refund for Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"149.99\",\n  \"reason\": \"Customer returned unopened item within 30-day window\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/refund/{{orderId}}"
          }
        },
        {
          "name": "Send Order Receipt Email",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/orders/receipt/{{orderId}}"
          }
        },
        {
          "name": "Get Shipments by Store",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/shipments/{{storeId}}"
          }
        },
        {
          "name": "Get Shipment Summary Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/shipments/summary/{{storeId}}"
          }
        },
        {
          "name": "Track Shipment by Shipment ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/shipment/track/{{shipmentId}}"
          }
        },
        {
          "name": "Public Track Shipment by Tracking ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/orders/track/{{trackingId}}"
          }
        },
        {
          "name": "Update Shipment Status & Live Location",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_transit\",\n  \"location\": \"Sorting Facility - North Hub\",\n  \"note\": \"Package scanned into regional sorting facility\"\n}"
            },
            "url": "{{baseUrl}}/api/orders/shipment/status/{{shipmentId}}"
          }
        }
      ]
    },
    {
      "name": "7. Marketing & Campaigns",
      "item": [
        {
          "name": "Create Marketing Campaign",
          "request": {
            "method": "POST",
